{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "KerfPulse completed-cut event v1",
  "description": "Transport schema. Server separately validates freshness, sequence equality, qualification and feasible break horizons. Missing feature channels are valid transport but produce insufficient_evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "asset_id",
    "tool_life_id",
    "sequence_number",
    "cut_completed_at",
    "source_mode",
    "clock_basis",
    "data_origin",
